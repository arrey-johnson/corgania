# --- Supabase (create a project, then fill these in; see docs/ENVIRONMENT_SETUP.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — never expose to the browser
# Optional — only needed for CLI migration push (Settings → Database → Connection string)
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# --- Providers (leave blank = honest "not configured" state, nothing is faked) ---
# Free monthly benchmarks (World Bank Pink Sheet). No API key required.
MARKET_DATA_PROVIDER=worldbank_pink_sheet
# MARKET_DATA_API_KEY=              # only needed for paid providers later

EMAIL_PROVIDER=                     # e.g. resend | postmark
EMAIL_API_KEY=
EMAIL_FROM=
# --- Membership (Founder's enrollment window end, ISO date UTC) ---
# FOUNDERS_ENROLLMENT_ENDS=2027-10-25

